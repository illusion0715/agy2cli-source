{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archival example configuration; not loaded automatically",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "archive_only": {
      "const": true
    },
    "API_PASSWORD": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit caller-provided secret; examples are fake"
    },
    "PANEL_PASSWORD": {
      "type": "string",
      "minLength": 1
    },
    "PROXY": {
      "type": [
        "string",
        "null"
      ]
    },
    "oauth_client_id": {
      "type": "string"
    },
    "oauth_client_secret": {
      "type": "string"
    }
  },
  "required": [
    "archive_only",
    "API_PASSWORD",
    "PANEL_PASSWORD"
  ]
}
